# Windows script files must use CRLF
*.bat text eol=crlf

# Unix shell scripts must use LF (CRLF breaks gradlew on Windows: "/bin/bash^M: bad interpreter")
gradlew text eol=lf
*.sh text eol=lf

# Xcode project files should not be text-converted (can corrupt pbxproj)
*.pbxproj -text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.keystore binary
*.jks binary

# Default: text files use LF
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.plist text eol=lf
*.md text eol=lf
*.rb text eol=lf
